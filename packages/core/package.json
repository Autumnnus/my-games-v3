    "ai": "^7.0.118",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "catalog:",
    "jpeg-js": "^0.4.4",
    "pg": "catalog:",
    "psn-api": "^2.18.1",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "@types/web-push": "^3.6.4",
    "tsx": "catalog:",
    "vitest": "^5.0.2"
