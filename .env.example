# --- Uygulama ---
# Tarayıcının uygulamaya eriştiği adres (auth callback'leri ve e-posta linkleri bunu kullanır)
APP_URL=http://localhost:3300
# "Bugün", günlük akış grupları, ısı haritası ve yıl özeti bu saat dilimine göre hesaplanır
APP_TIMEZONE=Europe/Istanbul
DATABASE_URL=postgresql://mygames:mygames@localhost:5433/mygames
# `openssl rand -base64 32` ile üret
BETTER_AUTH_SECRET=

# --- OAuth (opsiyonel; boş bırakılan sağlayıcı kapalı olur) ---
# Google callback: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord callback: {APP_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- E-posta (geliştirmede opsiyonel, boşsa konsola yazılır; production'da zorunlu) ---
RESEND_API_KEY=
EMAIL_FROM="My Games <noreply@example.com>"

# --- Yasal sayfalar: gizlilik/şartlar sayfalarındaki ve hesap silme talebindeki adres (production'da zorunlu) ---
CONTACT_EMAIL=

# --- Dosya depolama (S3 uyumlu: production'da Cloudflare R2, yerelde MinIO) ---
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
#     S3_PUBLIC_URL=https://<bucket'ın public domaini>
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=my-games
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9100/my-games
# Kullanıcı başına varsayılan kota (MB) ve tüm yüklemelerin üst sınırı (GB). Bkz. docs/notes/storage.md
STORAGE_DEFAULT_QUOTA_MB=250
STORAGE_BUDGET_GB=8

# --- Oyun verisi ---
# https://api-docs.igdb.com/#account-creation (Twitch uygulaması)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Xbox: Azure uygulaması (yalnızca kişisel Microsoft hesapları), redirect {APP_URL}/api/v1/platforms/xbox/callback
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
# PlayStation anahtar istemez (kullanıcı kendi NPSSO kodunu girer). Kapatmak için: PSN_DISABLED=true
# PSN/Xbox token'larını ve panelden eklenen AI anahtarlarını şifreleyen sır; boşsa BETTER_AUTH_SECRET kullanılır.
# app ve worker'da AYNI değer olmalı (worker panel anahtarlarını bununla çözer). Sonradan değiştirirsen
# kayıtlı anahtarlar çözülemez, panelden yeniden eklemek gerekir.
CREDENTIALS_SECRET=

# --- Bot koruması: Cloudflare Turnstile (geliştirmede opsiyonel, production'da zorunlu) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Web Push (opsiyonel): `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Pati, AI asistan (opsiyonel) ---
# Sağlayıcı: google (varsayılan). Yerelde anahtarsız denemek için: AI_PROVIDER=mock
AI_PROVIDER=
# Anahtar havuzu tercihen yönetim panelinden (/admin/ai) yönetilir: ekle, dene, adlandır, aç/kapat, sırala.
# Buradaki anahtarlar da havuza girer (panel anahtarlarından sonra, panelde salt okunur). Virgülle ayrılmış
# birden çok anahtar; birinin kotası/hız sınırı dolunca sıradakine geçilir. Gemini: https://aistudio.google.com/apikey
# (tek anahtar için GOOGLE_GENERATIVE_AI_API_KEY de olur; AI_API_KEYS varsayılan sağlayıcının havuzuna eklenir)
GOOGLE_GENERATIVE_AI_API_KEYS=
# round_robin: yükü anahtarlara dağıtır (varsayılan) · failover: sıradakine yalnızca önceki dolunca geçer.
# Panelden seçilen strateji bunu ezer.
AI_KEY_STRATEGY=
# Modeller (boşsa sağlayıcının varsayılanı). `sağlayıcı:model` biçimi de olur.
AI_MODEL=gemini-3.5-flash
# Ana modelin bütün anahtarları dolunca sırayla denenir (Gemini'de kota model başınadır).
AI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Başlık, "Ne oynasam?" gerekçesi, inceleme taslağı, "Kaldığın yer" özeti gibi kısa işler.
AI_LIGHT_MODEL=gemini-3.5-flash-lite
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_STEPS=10
