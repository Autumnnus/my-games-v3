# --- Uygulama ---
# Tarayıcının uygulamaya eriştiği adres (auth callback'leri ve e-posta linkleri bunu kullanır)
APP_URL=http://localhost:3300
# "Bugün", günlük akış grupları, ısı haritası ve yıl özeti bu saat dilimine göre hesaplanır
APP_TIMEZONE=Europe/Istanbul
DATABASE_URL=postgresql://mygames:mygames@localhost:5433/mygames
# `openssl rand -base64 32` ile üret
BETTER_AUTH_SECRET=

# --- OAuth (opsiyonel; boş bırakılan sağlayıcı kapalı olur) ---
# Google callback: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord callback: {APP_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- E-posta (opsiyonel; boşsa e-postalar konsola yazılır) ---
RESEND_API_KEY=
EMAIL_FROM="My Games <noreply@example.com>"

# --- Dosya depolama (S3 uyumlu: production'da Cloudflare R2, yerelde MinIO) ---
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
#     S3_PUBLIC_URL=https://<bucket'ın public domaini>
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=my-games
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9100/my-games

# --- Oyun verisi ---
# https://api-docs.igdb.com/#account-creation (Twitch uygulaması)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Xbox: Azure uygulaması (yalnızca kişisel Microsoft hesapları), redirect {APP_URL}/api/v1/platforms/xbox/callback
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
# PlayStation anahtar istemez (kullanıcı kendi NPSSO kodunu girer). Kapatmak için: PSN_DISABLED=true
# Platform token'larını şifreleyen sır; boşsa BETTER_AUTH_SECRET kullanılır (worker'da da aynısı olmalı)
CREDENTIALS_SECRET=

# --- Bot koruması (opsiyonel): Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Web Push (opsiyonel): `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- AI (opsiyonel) ---
# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_DAILY_TOKEN_LIMIT=200000
# Yerelde anahtarsız denemek için: AI_PROVIDER=mock
AI_PROVIDER=
