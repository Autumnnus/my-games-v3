PORT=3030
NODE_ENV=development

# Local MongoDB in Docker
MONGO_URL=mongodb://localhost:27017/my-games

# JWT (min 32 chars)
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_EXPIRE=7d

# Cloudflare R2 (or S3 compatible storage)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_KEY=R2_ACCESS_KEY_ID
R2_SECRET=R2_SECRET_ACCESS_KEY
R2_BUCKET=my-games
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev

# Email
SMTP_HOST=smtp.gmail.com
SMTP_USER=example@gmail.com
SMTP_PASS=app-password

# Frontend
FRONTEND_URL=http://localhost:5173

# IGDB (Twitch)
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Steam (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key
STEAM_REALM=http://localhost:3030
STEAM_RETURN_URL=http://localhost:3030/api/auth/steam/callback
